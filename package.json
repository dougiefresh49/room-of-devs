{
  "name": "room-of-devs",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "pnpm -r --if-present run typecheck",
    "check-fixtures": "pnpm --filter @room/protocol run check-fixtures",
    "check-live-fixtures": "pnpm --dir tts-server exec tsx scripts/mock-live.ts check-tailer",
    "docs:publish": "node scripts/docs-publish.mjs",
    "lint": "biome lint .",
    "check-overrides": "node scripts/check-class-overrides.mjs",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "node-hid"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "marked": "^18.0.7"
  }
}
